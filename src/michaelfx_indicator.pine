//@version=5
// ============================================================================
// MichaelFX — Reglas en acción (indicador de contexto para operar el sistema)
// Dibuja: sesgo D/4H/1H, PDH/PDL, sesiones (UTC-5), Order Blocks aprox (bull/bear),
// BOS (ruptura de estructura) y marca cuando el precio MITIGA un OB en dirección del sesgo.
// NO ejecuta órdenes: es apoyo visual para operar MichaelFX con disciplina (no solo tu bias).
// Copiar en TradingView → Pine Editor → Add to chart. Recomendado en 15m/5m.
// ============================================================================
indicator("MichaelFX — Reglas en acción", overlay=true, max_boxes_count=200, max_lines_count=100, max_labels_count=200)

// ---------------- Inputs ----------------
gB = "Sesgo (Bias)"
emaF = input.int(20, "EMA rápida", group=gB)
emaS = input.int(50, "EMA lenta", group=gB)
showTable = input.bool(true, "Tabla de sesgo D/4H/1H", group=gB)

gO = "Order Blocks (aprox)"
showOB = input.bool(true, "Mostrar OB", group=gO)
obStr = input.int(5, "Fuerza de ruptura (velas)", minval=2, group=gO)
obScan = input.int(15, "Escaneo hacia atrás del OB", minval=3, group=gO)
maxOB = input.int(4, "Máx OB por lado", minval=1, group=gO)

gL = "Niveles y sesiones"
showPDHL = input.bool(true, "PDH/PDL (día anterior)", group=gL)
showSess = input.bool(true, "Sesiones operativas (UTC-5)", group=gL)
showSig = input.bool(true, "Marcar mitigación de OB en dirección del sesgo", group=gL)

// ---------------- Sesgo multi-TF ----------------
f_trend(tf) =>
    ef = request.security(syminfo.tickerid, tf, ta.ema(close, emaF), lookahead=barmerge.lookahead_off)
    es = request.security(syminfo.tickerid, tf, ta.ema(close, emaS), lookahead=barmerge.lookahead_off)
    cc = request.security(syminfo.tickerid, tf, close, lookahead=barmerge.lookahead_off)
    cc > ef and ef > es ? 1 : (cc < ef and ef < es ? -1 : 0)

biasD = f_trend("D")
bias4 = f_trend("240")
bias1 = f_trend("60")
f_txt(b) => b == 1 ? "▲ ALCISTA" : b == -1 ? "▼ BAJISTA" : "► RANGO"
f_col(b) => b == 1 ? color.new(color.green, 0) : b == -1 ? color.new(color.red, 0) : color.new(color.gray, 0)

if showTable and barstate.islast
    var table t = table.new(position.top_right, 2, 4, border_width=1, frame_color=color.gray, frame_width=1)
    table.cell(t, 0, 0, "TF", bgcolor=color.gray, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, "Sesgo", bgcolor=color.gray, text_color=color.white, text_size=size.small)
    table.cell(t, 0, 1, "Diario", text_size=size.small)
    table.cell(t, 1, 1, f_txt(biasD), text_color=f_col(biasD), text_size=size.small)
    table.cell(t, 0, 2, "4H", text_size=size.small)
    table.cell(t, 1, 2, f_txt(bias4), text_color=f_col(bias4), text_size=size.small)
    table.cell(t, 0, 3, "1H", text_size=size.small)
    table.cell(t, 1, 3, f_txt(bias1), text_color=f_col(bias1), text_size=size.small)

// ---------------- PDH/PDL (día anterior) ----------------
pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)
var line lpdh = na
var line lpdl = na
var label bpdh = na
var label bpdl = na
if showPDHL and barstate.islast
    line.delete(lpdh), line.delete(lpdl), label.delete(bpdh), label.delete(bpdl)
    lpdh := line.new(bar_index - 100, pdh, bar_index, pdh, color=color.new(color.blue, 0), style=line.style_dashed, extend=extend.right)
    lpdl := line.new(bar_index - 100, pdl, bar_index, pdl, color=color.new(color.blue, 0), style=line.style_dashed, extend=extend.right)
    bpdh := label.new(bar_index, pdh, "PDH", style=label.style_none, textcolor=color.blue, size=size.small)
    bpdl := label.new(bar_index, pdl, "PDL", style=label.style_none, textcolor=color.blue, size=size.small)

// ---------------- Sesiones (UTC-5) ----------------
inSess(s) => not na(time(timeframe.period, s, "GMT-5"))
london = showSess and inSess("0130-0430")
ny     = showSess and inSess("0730-1030")
tokyo  = showSess and inSess("1830-2130")
bgcolor(london ? color.new(color.blue, 90) : na, title="London")
bgcolor(ny     ? color.new(color.orange, 90) : na, title="New York")
bgcolor(tokyo  ? color.new(color.purple, 90) : na, title="Tokio")

// ---------------- Order Blocks (aprox) ----------------
// BOS alcista: cierre rompe el máximo de las `obStr` velas previas → OB = última vela bajista antes.
// BOS bajista: cierre rompe el mínimo previo → OB = última vela alcista antes.
bosUp = close > ta.highest(high, obStr)[1] and close[1] <= ta.highest(high, obStr)[2]
bosDn = close < ta.lowest(low, obStr)[1] and close[1] >= ta.lowest(low, obStr)[2]

var box[] bullOB = array.new_box()
var box[] bearOB = array.new_box()

f_lastOppo(wantBear) =>
    idx = 0
    for i = 1 to obScan
        if wantBear and close[i] < open[i]
            idx := i
            break
        if not wantBear and close[i] > open[i]
            idx := i
            break
    idx

if showOB and bosUp
    i = f_lastOppo(true)
    if i > 0
        b = box.new(bar_index - i, high[i], bar_index + 10, low[i], border_color=color.new(color.green, 30), bgcolor=color.new(color.green, 85), extend=extend.right)
        array.push(bullOB, b)
        if array.size(bullOB) > maxOB
            box.delete(array.shift(bullOB))
if showOB and bosDn
    i = f_lastOppo(false)
    if i > 0
        b = box.new(bar_index - i, high[i], bar_index + 10, low[i], border_color=color.new(color.red, 30), bgcolor=color.new(color.red, 85), extend=extend.right)
        array.push(bearOB, b)
        if array.size(bearOB) > maxOB
            box.delete(array.shift(bearOB))

// BOS labels
plotshape(showOB and bosUp, title="BOS↑", style=shape.triangleup, location=location.belowbar, color=color.new(color.green, 0), size=size.tiny)
plotshape(showOB and bosDn, title="BOS↓", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.tiny)

// ---------------- Señal: mitigación de OB en dirección del sesgo (1H) ----------------
f_tapBull() =>
    tapped = false
    if array.size(bullOB) > 0
        for i = 0 to array.size(bullOB) - 1
            bx = array.get(bullOB, i)
            if low <= box.get_top(bx) and low >= box.get_bottom(bx)
                tapped := true
    tapped
f_tapBear() =>
    tapped = false
    if array.size(bearOB) > 0
        for i = 0 to array.size(bearOB) - 1
            bx = array.get(bearOB, i)
            if high >= box.get_bottom(bx) and high <= box.get_top(bx)
                tapped := true
    tapped

longSig  = showSig and bias1 == 1 and f_tapBull()
shortSig = showSig and bias1 == -1 and f_tapBear()
plotshape(longSig,  title="Posible LONG",  style=shape.labelup,   location=location.belowbar, color=color.new(color.green, 0), text="MFX↑", textcolor=color.white, size=size.small)
plotshape(shortSig, title="Posible SHORT", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0),   text="MFX↓", textcolor=color.white, size=size.small)

alertcondition(longSig,  title="MFX Long",  message="MichaelFX: mitigación OB alcista en sesgo alcista")
alertcondition(shortSig, title="MFX Short", message="MichaelFX: mitigación OB bajista en sesgo bajista")
