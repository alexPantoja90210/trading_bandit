//@version=5
// ============================================================================
// MichaelFX — Reglas en acción (v2, decluttered)
// Sesgo D/4H/1H (tabla legible), PDH/PDL, sesiones (UTC-5), Order Blocks aprox que se
// BORRAN al mitigarse (precio los toca) + señal MFX una sola vez al tocar en dirección del sesgo.
// NO ejecuta órdenes: apoyo visual para operar MichaelFX con disciplina. Mejor en 15m/5m.
// ============================================================================
indicator("MichaelFX — Reglas en acción", overlay=true, max_boxes_count=60, max_lines_count=60, max_labels_count=60)

// ---------------- Inputs ----------------
gB = "Sesgo (Bias)"
emaF = input.int(20, "EMA rápida", group=gB)
emaS = input.int(50, "EMA lenta", group=gB)
showTable = input.bool(true, "Tabla de sesgo D/4H/1H", group=gB)
tblPos = input.string("Sup. derecha", "Posición tabla", options=["Sup. derecha", "Sup. izquierda", "Inf. derecha"], group=gB)

gO = "Order Blocks (aprox)"
showOB = input.bool(true, "Mostrar OB", group=gO)
obStr = input.int(5, "Fuerza de ruptura (velas)", minval=2, group=gO)
obScan = input.int(15, "Escaneo hacia atrás del OB", minval=3, group=gO)
maxOB = input.int(5, "Máx OB por lado (conserva los más CERCANOS)", minval=1, maxval=10, group=gO)
onlyBiasOB = input.bool(true, "Solo OB a favor del sesgo 1H", group=gO)

gL = "Niveles y sesiones"
showPDHL = input.bool(true, "PDH/PDL (día anterior)", group=gL)
showSess = input.bool(true, "Sesiones operativas (UTC-5)", group=gL)
showSig = input.bool(true, "Señal MFX al mitigar OB en sesgo", group=gL)
reqConf = input.bool(true, "Solo señales CONFIRMADAS (confluencia PDH/PDL o Fib)", group=gL)
fibW = input.int(160, "Swing para zona Fib (velas)", minval=40, group=gL)
cooldown = input.int(8, "Mín. velas entre señales MFX (anti-apilado)", minval=1, group=gL)

// ---------------- Sesgo multi-TF ----------------
f_trend(tf) =>
    ef = request.security(syminfo.tickerid, tf, ta.ema(close, emaF), lookahead=barmerge.lookahead_off)
    es = request.security(syminfo.tickerid, tf, ta.ema(close, emaS), lookahead=barmerge.lookahead_off)
    cc = request.security(syminfo.tickerid, tf, close, lookahead=barmerge.lookahead_off)
    cc > ef and ef > es ? 1 : (cc < ef and ef < es ? -1 : 0)

biasD = f_trend("D")
bias4 = f_trend("240")
bias1 = f_trend("60")
f_txt(b) => b == 1 ? "▲ ALCISTA" : b == -1 ? "▼ BAJISTA" : "► RANGO"
f_col(b) => b == 1 ? #26a69a : b == -1 ? #ef5350 : #b0b0b0

// Tabla con fondo SÓLIDO oscuro para legibilidad en cualquier tema de TradingView
var table t = na
if showTable and barstate.islast
    pos = tblPos == "Sup. izquierda" ? position.top_left : tblPos == "Inf. derecha" ? position.bottom_right : position.top_right
    t := table.new(pos, 2, 4, border_width=1, frame_color=#4a4a4a, frame_width=1, bgcolor=#1e222d)
    table.cell(t, 0, 0, "TF", bgcolor=#2a2e39, text_color=color.white, text_size=size.normal)
    table.cell(t, 1, 0, "Sesgo", bgcolor=#2a2e39, text_color=color.white, text_size=size.normal)
    table.cell(t, 0, 1, "Diario", bgcolor=#1e222d, text_color=color.white, text_size=size.normal)
    table.cell(t, 1, 1, f_txt(biasD), bgcolor=#1e222d, text_color=f_col(biasD), text_size=size.normal)
    table.cell(t, 0, 2, "4H", bgcolor=#1e222d, text_color=color.white, text_size=size.normal)
    table.cell(t, 1, 2, f_txt(bias4), bgcolor=#1e222d, text_color=f_col(bias4), text_size=size.normal)
    table.cell(t, 0, 3, "1H", bgcolor=#1e222d, text_color=color.white, text_size=size.normal)
    table.cell(t, 1, 3, f_txt(bias1), bgcolor=#1e222d, text_color=f_col(bias1), text_size=size.normal)

// ---------------- PDH/PDL ----------------
pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)
var line lpdh = na
var line lpdl = na
var label bpdh = na
var label bpdl = na
if showPDHL and barstate.islast
    line.delete(lpdh)
    line.delete(lpdl)
    label.delete(bpdh)
    label.delete(bpdl)
    lpdh := line.new(bar_index - 80, pdh, bar_index, pdh, color=#2962ff, style=line.style_dashed, extend=extend.right)
    lpdl := line.new(bar_index - 80, pdl, bar_index, pdl, color=#2962ff, style=line.style_dashed, extend=extend.right)
    bpdh := label.new(bar_index, pdh, "PDH", style=label.style_none, textcolor=#2962ff, size=size.small)
    bpdl := label.new(bar_index, pdl, "PDL", style=label.style_none, textcolor=#2962ff, size=size.small)

// ---------------- Sesiones (UTC-5) ----------------
inSess(s) => not na(time(timeframe.period, s, "GMT-5"))
bgcolor(showSess and inSess("0130-0430") ? color.new(#2962ff, 92) : na, title="London")
bgcolor(showSess and inSess("0730-1030") ? color.new(#ff9800, 92) : na, title="New York")
bgcolor(showSess and inSess("1830-2130") ? color.new(#9c27b0, 92) : na, title="Tokio")

// ---------------- Zona Fib (descuento/premium) + confluencia ----------------
fibHi = ta.highest(high, fibW)[1]
fibLo = ta.lowest(low, fibW)[1]
fibRng = fibHi - fibLo
discLo = fibHi - 0.75 * fibRng    // zona de DESCUENTO (para longs): 61.8-75%
discHi = fibHi - 0.618 * fibRng
premLo = fibLo + 0.618 * fibRng   // zona PREMIUM (para shorts)
premHi = fibLo + 0.75 * fibRng

// confluencia de una zona OB [top,bot]: cerca de PDH/PDL O dentro de la banda Fib
f_conf(top, bot, isBull) =>
    tol = 0.0025 * close
    lvl = isBull ? pdl : pdh
    pdOk = not na(lvl) and (bot - tol) <= lvl and lvl <= (top + tol)
    fibOk = isBull ? not (top < discLo or bot > discHi) : not (top < premLo or bot > premHi)
    pdOk or fibOk

// ---------------- Order Blocks con BORRADO por mitigación ----------------
var box[] bBox = array.new_box()
var float[] bTop = array.new_float()
var float[] bBot = array.new_float()
var box[] sBox = array.new_box()
var float[] sTop = array.new_float()
var float[] sBot = array.new_float()

bosUp = close > ta.highest(high, obStr)[1] and close[1] <= ta.highest(high, obStr)[2]
bosDn = close < ta.lowest(low, obStr)[1] and close[1] >= ta.lowest(low, obStr)[2]

f_lastOppo(wantBear) =>
    idx = 0
    for i = 1 to obScan
        if (wantBear and close[i] < open[i]) or (not wantBear and close[i] > open[i])
            idx := i
            break
    idx

// evicción del OB MÁS LEJANO al precio (conserva los cercanos aunque sean antiguos)
f_evictFar(bx, tp, bt) =>
    if array.size(bx) > maxOB
        fi = 0
        fd = 0.0
        for k = 0 to array.size(bx) - 1
            dd = math.abs(close - (array.get(tp, k) + array.get(bt, k)) / 2.0)
            if dd > fd
                fd := dd
                fi := k
        box.delete(array.get(bx, fi))
        array.remove(bx, fi)
        array.remove(tp, fi)
        array.remove(bt, fi)

// crear OB (a favor del sesgo si onlyBiasOB)
if showOB and bosUp and (not onlyBiasOB or bias1 >= 0)
    i = f_lastOppo(true)
    if i > 0
        b = box.new(bar_index - i, high[i], bar_index + 8, low[i], border_color=color.new(#26a69a, 40), bgcolor=color.new(#26a69a, 88), extend=extend.right)
        array.push(bBox, b)
        array.push(bTop, high[i])
        array.push(bBot, low[i])
        f_evictFar(bBox, bTop, bBot)
if showOB and bosDn and (not onlyBiasOB or bias1 <= 0)
    i = f_lastOppo(false)
    if i > 0
        b = box.new(bar_index - i, high[i], bar_index + 8, low[i], border_color=color.new(#ef5350, 40), bgcolor=color.new(#ef5350, 88), extend=extend.right)
        array.push(sBox, b)
        array.push(sTop, high[i])
        array.push(sBot, low[i])
        f_evictFar(sBox, sTop, sBot)

// mitigación: si el precio TOCA el OB → señal una vez + BORRAR el OB (declutter)
longTap = false
i1 = array.size(bBox) - 1
while i1 >= 0
    top1 = array.get(bTop, i1)
    bot1 = array.get(bBot, i1)
    if low <= top1 and low[1] > top1                     // entró FRESCO a la demanda
        if (not reqConf) or f_conf(top1, bot1, true)
            longTap := true
    if close < bot1                                       // invalidado: cierre bajo la zona
        box.delete(array.get(bBox, i1))
        array.remove(bBox, i1)
        array.remove(bTop, i1)
        array.remove(bBot, i1)
    i1 := i1 - 1
shortTap = false
i2 = array.size(sBox) - 1
while i2 >= 0
    top2 = array.get(sTop, i2)
    bot2 = array.get(sBot, i2)
    if high >= bot2 and high[1] < bot2                    // entró FRESCO a la oferta
        if (not reqConf) or f_conf(top2, bot2, false)
            shortTap := true
    if close > top2                                       // invalidado: cierre sobre la zona
        box.delete(array.get(sBox, i2))
        array.remove(sBox, i2)
        array.remove(sTop, i2)
        array.remove(sBot, i2)
    i2 := i2 - 1

// BOS marcas (pequeñas)
plotshape(showOB and bosUp, title="BOS up", style=shape.triangleup, location=location.belowbar, color=color.new(#26a69a, 20), size=size.tiny)
plotshape(showOB and bosDn, title="BOS dn", style=shape.triangledown, location=location.abovebar, color=color.new(#ef5350, 20), size=size.tiny)

// señal MFX (al mitigar, en dirección del sesgo 1H) + COOLDOWN anti-apilado
var int lastLong = -10000
var int lastShort = -10000
longRaw = showSig and longTap and bias1 == 1
shortRaw = showSig and shortTap and bias1 == -1
longSig = longRaw and (bar_index - lastLong) >= cooldown
shortSig = shortRaw and (bar_index - lastShort) >= cooldown
if longSig
    lastLong := bar_index
if shortSig
    lastShort := bar_index
plotshape(longSig, title="MFX Long", style=shape.labelup, location=location.belowbar, color=#26a69a, text="MFX↑", textcolor=color.white, size=size.small)
plotshape(shortSig, title="MFX Short", style=shape.labeldown, location=location.abovebar, color=#ef5350, text="MFX↓", textcolor=color.white, size=size.small)
alertcondition(longSig, title="MFX Long", message="MichaelFX: mitigación OB alcista en sesgo alcista")
alertcondition(shortSig, title="MFX Short", message="MichaelFX: mitigación OB bajista en sesgo bajista")
